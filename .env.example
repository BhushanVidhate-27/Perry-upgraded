# Perry, local env. Copy to .env.local, or let `perry setup` write it.
# The dashboard's server, which is also Perry's backend, reads it.

# Guards the dashboard and the backend's API. Any long random string.
DASHBOARD_KEY=generate-a-long-random-string

# Optional: a Telegram bot from @BotFather. Perry polls Telegram with it.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Password-protect the web dashboard home page.
# Set via .env.local, deployment env vars, or Telegram: /password set <your-password>
PERRY_PASSWORD=your-chosen-password

# B2 Backblaze cloud storage (set these in Settings → Logins & secrets too)
# Get them from: https://app.backblaze.com/b2-cloud-storage/buckets
B2_KEY_ID=your-b2-key-id
B2_APPLICATION_KEY=your-b2-application-key
B2_BUCKET_NAME=your-bucket-name

# Optional: Gmail, Calendar, Notion and the rest, through Composio.
# COMPOSIO_API_KEY=

# Optional: where Perry keeps its data (default ~/.perry), and its port (7377).
# On a container, point PERRY_HOME at a mounted volume so memory survives a restart.
# PERRY_HOME=
# PERRY_PORT=

# Azure VM controller: lets Perry's own /start-vm, /stop-vm, /status-vm and
# /restart-vm commands reach the App Service while the VM is off. See
# cloud/azure-vm-controller/README.md.
# PERRY_VM_CONTROL_URL=https://<app>.azurewebsites.net/api/control
# PERRY_VM_CONTROL_KEY=generate-a-long-random-string

# career-ops (workspace/career-ops) renders CV PDFs with Playwright's Chromium.
# The container bakes the browser in here; without it Playwright looks in
# ~/.cache/ms-playwright and a container recreate loses the download.
# PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

# On a host with no disk (a fresh volume), name the owner so the install comes
# back claimed instead of asking for a pairing code.
# PERRY_OWNER_TELEGRAM_ID=
# PERRY_OWNER_NAME=

# Optional: the cloud link reader (cloud/read-link) for video and social links.
# The Worker's URL and the shared token you set as its PIPELINE_TOKEN secret.
# PIPELINE_URL=https://perry-read-link.<you>.workers.dev
# PIPELINE_TOKEN=
